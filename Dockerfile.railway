# Railway上で永続Volumeの設定を直接読むNodeCGバンドル
FROM node:22-alpine

# Install dependencies for building native modules
RUN apk add --no-cache python3 make g++ git

# pnpm を有効化
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@12.4.0 --activate

# Set working directory
WORKDIR /app

# Install bundle dependencies (レイヤーキャッシュ用に先にマニフェストのみコピー)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /app/
RUN pnpm install --frozen-lockfile

# Copy bundle source code
COPY . /app/

# Build the bundle
RUN pnpm run build

# Generate schema types
RUN pnpm run generate-schema-types

# cfg/nodecg.jsonとRailwayのtarget portも9090に揃える
ENV PORT=9090
EXPOSE 9090

# /dataは起動時にRailway Volumeがマウントされる。
# 実ディレクトリと設定ファイルはVolume上に一度だけ準備する。
RUN ln -s /data/cfg /app/cfg && \
    ln -s /data/db /app/db && \
    ln -s /data/logs /app/logs && \
    ln -s /data/assets /app/assets

# Create non-root user for security
RUN addgroup -g 1001 -S nodecg && \
    adduser -S nodecg -u 1001 -G nodecg && \
    chown -R nodecg:nodecg /app

USER nodecg

# 設定の生成・上書きやパッケージマネージャーの起動を行わない
CMD ["node", "/app/node_modules/nodecg/index.js"]
