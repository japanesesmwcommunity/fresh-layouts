{
	"name": "fresh-layouts",
	"version": "1.0.0",
	"packageManager": "pnpm@12.4.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "run-p dev:*",
		"dev:tsc": "tsc -b src/browser src/extension -w --preserveWatchOutput",
		"dev:vite": "vite",
		"dev:nodecg": "nodecg start",
		"generate-schema-types": "nodecg schema-types -o ./src/nodecg/generated",
		"build": "vite build"
	},
	"nodecg": {
		"compatibleRange": "^2.0.0",
		"assetCategories": [
			{
				"name": "test",
				"title": "Test",
				"allowedTypes": [
					"jpg",
					"jpeg",
					"gif",
					"png"
				]
			}
		],
		"dashboardPanels": [
			{
				"name": "run",
				"title": "進行中",
				"fullbleed": true,
				"file": "Run.html",
				"headerColor": "#525F78"
			},
			{
				"name": "info",
				"title": "情報管理",
				"fullbleed": true,
				"file": "Info.html",
				"headerColor": "#525F78"
			}
		],
		"graphics": [
			{
				"file": "Generic.html",
				"width": 1920,
				"height": 1080,
				"singleInstance": false
			},
			{
				"file": "Setup.html",
				"width": 1920,
				"height": 1080,
				"singleInstance": false
			},
			{
				"file": "ThreePlayer.html",
				"width": 1920,
				"height": 1080,
				"singleInstance": false
			},
			{
				"file": "FourPlayer.html",
				"width": 1920,
				"height": 1080,
				"singleInstance": false
			}
		]
	},
	"devDependencies": {
		"@nodecg/types": "^2.8.0",
		"@types/react": "^18.3.8",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "^4.3.1",
		"globby": "^14.0.2",
		"npm-run-all": "^4.1.5",
		"prettier-plugin-organize-imports": "^4.2.0",
		"rollup": "^4.63.1",
		"rollup-plugin-esbuild": "^6.1.1",
		"rollup-plugin-node-externals": "^7.1.3",
		"trash-cli": "^6.0.0",
		"ts-nodecg": "^0.3.1",
		"typescript": "^5.6.2",
		"vite": "^7.1.3"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource-variable/jetbrains-mono": "^5.2.6",
		"@fontsource/fira-code": "^5.2.6",
		"@fontsource/m-plus-rounded-1c": "^5.2.8",
		"@googleapis/sheets": "^11.1.0",
		"@mdi/react": "^1.6.1",
		"@mui/icons-material": "^7.3.1",
		"@mui/material": "^7.3.1",
		"@nodecg/react-hooks": "^1.0.3",
		"klona": "^2.0.6",
		"nodecg": "^2.8.0",
		"prettier": "^3.6.2",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tslib": "^2.8.1"
	}
}
